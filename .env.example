# Supabase Database & API Keys (Free Tier Compatible)
# 1. Sign up at https://supabase.com and create a free project
# 2. Go to Project Settings -> Database -> Connection string (URI) to get your DATABASE_URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Client configuration for client/edge access
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
